# Neon Postgres. На Vercel подставляются интеграцией автоматически.
# Локально скопируйте в `.env` (Prisma CLI читает именно `.env`).
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# Токен доступа к API. Сгенерируйте: openssl rand -base64 32
# Этот же токен приложение хранит в Keychain.
# Если переменная не задана — API отвечает 503 и не пускает никого.
HISOB_API_TOKEN=""
