{
  "name": "hisob-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch scripts/serve.ts",
    "start": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:legacy": "tsx scripts/check-legacy-mapping.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "npm run db:check && prisma migrate deploy",
    "db:status": "tsx --env-file-if-exists=.env scripts/db-status.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "db:studio": "prisma studio",
    "import:legacy": "tsx --env-file-if-exists=.env scripts/import-legacy.ts",
    "db:check": "node --env-file-if-exists=.env scripts/check-db-env.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.5",
    "@prisma/client": "^6.19.3",
    "hono": "^4.10.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
